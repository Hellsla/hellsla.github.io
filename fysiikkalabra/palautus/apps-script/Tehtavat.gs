hy=\"false\">)</mo></mrow></semantics></math></span></th><th scope=\"col\"><span><math><semantics><mrow><mi>P</mi> <mo stretchy=\"false\">(</mo><mtext>W</mtext><mo stretchy=\"false\">)</mo></mrow></semantics></math></span></th></tr></thead><tbody><tr><td>10,0</td><td>1,8</td></tr><tr><td>20,0</td><td>3,4</td></tr><tr><td>30,0</td><td>5,4</td></tr><tr><td>40,0</td><td>6,9</td></tr><tr><td>50,0</td><td>8,8</td></tr></tbody></table>",
